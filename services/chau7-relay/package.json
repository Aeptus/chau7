{
  "name": "chau7-ios-relay",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check 'src/**/*.{ts,js,json}' 'test/**/*.{ts,js,json}' vitest.config.ts",
    "format:write": "prettier --write 'src/**/*.{ts,js,json}' 'test/**/*.{ts,js,json}' vitest.config.ts",
    "build": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test:unit": "node --test test/*.test.js",
    "test:integration": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261019.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    },
    "@cloudflare/vitest-plugin": {
      "zod": "4.6.6"
    }
  }
}
