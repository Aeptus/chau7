{
  "name": "chau7-ios-relay",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check 'src/**/*.{ts,js,json}' 'test/**/*.{ts,js,json}' vitest.config.ts",
    "format:write": "prettier --write 'src/**/*.{ts,js,json}' 'test/**/*.{ts,js,json}' vitest.config.ts",
    "build": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test:unit": "node --test test/*.test.js",
    "test:integration": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261006.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.145.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
